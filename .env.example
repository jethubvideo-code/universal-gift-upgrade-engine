# ==== Core (TARGET ENGINE — Universal, works with ANY collection / ANY number) ====
# No hardcoded collections or numbers exist in this codebase.

# Telegram Bot API (notifications + Mini App)
BOT_TOKEN=

# Telegram MTProto user session (for Saved Gifts + upgrade execution)
# Never share, never commit. User session and bot token are different entities.
TG_API_ID=
TG_API_HASH=

# 32+ byte random string; used to encrypt user MTProto session strings at rest (AES-256-GCM)
SESSION_ENCRYPTION_KEY=

# ==== Transport (Variant B — owner decision, Phase 0.4) ====
# botapi (default): upgrades execute through a Telegram BUSINESS CONNECTION
#   (the user links the bot in Telegram Business -> Bots and grants rights:
#   View gifts and Stars / Transfer and upgrade gifts / Transfer Stars).
#   No MTProto credentials needed; the bot token is the only credential.
# mtproto (Variant A): user MTProto session (GramJS) — requires TG_API_ID/TG_API_HASH.
TRANSPORT=botapi
# Optional: pin a specific business connection id (auto-discovered from the
# business_connection bot update when omitted).
BUSINESS_CONNECTION_ID=

# ==== Engine ====
# memory | file | sqlite
#   file = GITHUB ACTIONS MODE: state in data/state/*.json committed back to the repo
#   sqlite requires: npm i better-sqlite3 (self-hosted)
DB_BACKEND=file
DB_DIR=data/state
TEST_MODE=false

# HTTP API for the Mini App backend
PORT=8080
MINIAPP_URL=

# Scheduler / monitoring tuning (defaults are sane; see docs/DEPLOYMENT.md)
POLL_CONCURRENCY=8
CACHE_TTL_MS=60000
WORKER_TICK_MS=250

# Collection data source: 'mtproto' (official Telegram) or 'gifttracker' ( GiftTracker docs/gifts.json URL )
# t.me/nft is NEVER an execution API — only public info/prediction. Upgrade always goes through official Telegram API.
COLLECTION_SOURCE=mtproto
GIFTTRACKER_DATA_URL=
